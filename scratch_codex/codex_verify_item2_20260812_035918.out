     1	"""Tape-state MAP — Phase 1, SHADOW / observe-only (2026-08-02, operator directive).
     2	
     3	The operator's core problem: gates were being fit to ONE tape (a bull) and broke when the
     4	tape flipped. The fix is a two-layer design — (1) an explicit, observable MAP of the current
     5	tape per asset, and (2) behavior that shifts with it. This module is layer (1), Phase 1:
     6	compute a per-asset mechanical tape state each scan and append it to
     7	``data/calibration/tape_map.jsonl``. **NOTHING trades on this yet** — it is the map we validate
     8	(does it label the bull correctly? would it have flagged the flips we broke on?) BEFORE any
     9	behavior hangs off it (Phase 2).
    10	
    11	State per asset (computed from the asset's OWN indicators — no BTC input; alts self-classify):
    12	  - DIRECTION  : UP / DOWN / FLAT   (vote across MACD 5m/15m/1h signs, EMA stack, trend_direction)
    13	  - STRENGTH   : 0..1               (trend_strength; how decisively it's trending)
    14	  - VOLATILITY : atr% + percentile  (rolling per-asset, so "high/low vol" is relative to itself)
    15	  - CONFIDENCE : 0..1               (agreement of the direction signals x strength)
    16	
    17	Pure/robust: every input is optional (getattr fallbacks), never raises into a scan loop, and
    18	dedupes to ~once per asset per cycle. Fail-silent by construction.
    19	"""
    20	
    21	from __future__ import annotations
    22	
    23	import json
    24	import math
    25	import os
    26	import time as _time
    27	from collections import defaultdict, deque
    28	from pathlib import Path
    29	from threading import Lock
    30	from typing import Any, Optional
    31	
    32	_CALIB_DIR = Path(__file__).resolve().parent.parent.parent / "data" / "calibration"
    33	_MAP_PATH = _CALIB_DIR / "tape_map.jsonl"
    34	_VETO_SHADOW_PATH = _CALIB_DIR / "tape_side_veto_shadow.jsonl"
    35	
    36	# Rolling per-asset ATR% history so the volatility bucket is RELATIVE to each asset's own
    37	# recent range (a "high vol" read means high for THIS asset, not an absolute threshold).
    38	_ATR_HIST: dict[str, deque] = defaultdict(lambda: deque(maxlen=600))
    39	_LAST_LOG: dict[str, float] = {}
    40	# In-memory cache of the most-recent computed tape state per asset. Populated by
    41	# snapshot_and_log each cycle so latest_tape_state() is a dict lookup with ZERO file reads
    42	# (reading tape_map.jsonl per scan would be the jsonl-reread churn that ballooned RSS before).
    43	_LAST_STATE: dict[str, dict] = {}
    44	_LOCK = Lock()
    45	
    46	# 2026-08-11 HIGH-VOLATILITY LEAN PROMOTION — fixes the "map the tape" mislabel where a
    47	# high-volatility REVERSAL was tagged FLAT (a lagging MACD cancels the fresh EMA/trend votes,
    48	# so dscore lands at +/-1 and the static +/-2 threshold calls it FLAT while the tape is ripping).
    49	# When the tape is genuinely moving (vol_pctile >= _VOL_PROMOTE_PCTILE) AND there is a directional
    50	# lean (dscore = +/-1), follow the lean instead of blanket-FLAT. Low-vol +/-1 stays FLAT (real
    51	# chop). Revert: set _VOL_PROMOTE_ENABLED = False.
    52	_VOL_PROMOTE_ENABLED = True
    53	_VOL_PROMOTE_PCTILE = 0.70   # matches the existing vol_bucket "high" cutoff
    54	
    55	
    56	def _f(x: Any) -> Optional[float]:
    57	    try:
    58	        if x is None:
    59	            return None
    60	        v = float(x)
    61	        return v if math.isfinite(v) else None  # reject NaN/Inf (would break strict JSON)
    62	    except (TypeError, ValueError):
    63	        return None
    64	
    65	
    66	def _sign(x: Optional[float]) -> int:
    67	    if x is None:
    68	        return 0
    69	    return 1 if x > 0 else (-1 if x < 0 else 0)
    70	
    71	
    72	def _macd_sign(m: Any) -> int:
    73	    """MACD objects expose .histogram; a bare number is used directly."""
    74	    if m is None:
    75	        return 0
    76	    h = getattr(m, "histogram", None)
