+                    # window_floors — the 1h 0.90 floor never fired; parity with bitcoin.py:5384).
+                    _eff_floor = float(_window_floors.get(tf, floor))
+                    if fav_price < _eff_floor:
                         continue
                     if fav_price > price_max:
