   137	def macd_bearish_momentum_ok(m: Any) -> bool:
   138	    """True when MACD bundle shows momentum favoring DOWN (alt leg), for BUY_NO override."""
   139	    if m is None:
   140	        return False
   141	    crossover = getattr(m, "crossover", None) or ""
   142	    if crossover == "BEARISH_CROSS":
   143	        return True
   144	    try:
   145	        hist = float(getattr(m, "histogram", 0.0) or 0.0)
   146	    except (TypeError, ValueError):
   147	        hist = 0.0
   148	    rising = bool(getattr(m, "histogram_rising", False))
   149	    try:
   150	        macd_line = float(getattr(m, "macd_line", 0.0) or 0.0)
   151	        signal_line = float(getattr(m, "signal_line", 0.0) or 0.0)
   152	    except (TypeError, ValueError):
   153	        macd_line = signal_line = 0.0
   154	    if not rising and hist < 0:
   155	        return True
   156	    if macd_line < signal_line and hist <= 0:
   157	        return True
   158	    return False
   159	
