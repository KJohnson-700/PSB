import json, pathlib, collections
p=pathlib.Path('data/calibration/rejected_candidates_settled.jsonl')
counts=collections.Counter(); wins=collections.Counter(); examples=[]
if p.exists():
  with p.open() as f:
    for line in f:
      try: r=json.loads(line)
      except: continue
      ss=str(r.get('side_source') or r.get('context',{}).get('side_source') or '')
      if 'rsi_fade' in ss:
        k=(r.get('strategy'), r.get('window'), r.get('side'))
        counts[k]+=1; wins[k]+=1 if r.get('win') else 0
        if len(examples)<5: examples.append({x:r.get(x) for x in ['ts','strategy','window','side','action','win','side_source','reason']})
print('rsi_fade settled rows:', sum(counts.values()))
for k,n in counts.most_common(20):
  print(k, 'n=', n, 'wr=', round(wins[k]/n,3))
print('examples=', examples)

# Recent tape map key summary
p2=pathlib.Path('data/calibration/tape_map.jsonl')
last={}
if p2.exists():
  for line in p2.open():
    try: r=json.loads(line)
    except: continue
    last[r.get('asset')]=r
print('latest tape keys:', sorted(last))
for k in sorted(last):
  r=last[k]
  print(k, r.get('direction'), r.get('confidence'), r.get('ts'))
