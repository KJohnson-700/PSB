    78	        h = m  # maybe a plain number
    79	    return _sign(_f(h))
    80	
    81	
    82	def compute_tape_state(
    83	    asset: str,
    84	    *,
    85	    current_price: Any = None,
    86	    atr_14: Any = None,
    87	    trend_direction: Any = None,
    88	    trend_strength: Any = None,
