import json, pathlib, collections
p=pathlib.Path('data/paper_trades/test_20260811_143236/entries.jsonl')
counts=collections.Counter(); pnl=collections.Counter(); wins=collections.Counter(); samples=[]
if p.exists():
  for line in p.open():
    try: r=json.loads(line)
    except: continue
    if r.get('event')"'!='"'EXIT': continue
    extra=r.get('extra') or {}
    ss=str(extra.get('side_source') or '')
    if 'rsi_fade' in ss:
      k=(r.get('strategy'), extra.get('window_size'), r.get('action'))
      counts[k]+=1; wins[k]+=1 if (extra.get('result')=='WIN' or r.get('pnl',0)>0) else 0; pnl[k]+=float(r.get('pnl') or 0)
      if len(samples)<8: samples.append((r.get('timestamp'), k, r.get('pnl'), extra.get('rsi'), ss, extra.get('direction')))
print('paper 20260811 closed rsi_fade rows:', sum(counts.values()))
for k,n in counts.items(): print(k, 'n',n,'wins',wins[k],'pnl',round(pnl[k],2))
print('samples', samples)
