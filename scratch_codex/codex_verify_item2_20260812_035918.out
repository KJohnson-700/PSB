   189	        "rsi_14": _f(rsi_14),
   190	        "price": cp,
   191	    }
   192	
   193	
   194	def snapshot_and_log(asset: str, *, min_interval_s: float = 30.0, **indicators: Any) -> Optional[dict]:
   195	    """Compute + append one tape-state row for ``asset``. Deduped to ~once per asset per
   196	    cycle. NEVER raises (fail-silent) — safe to call from inside a scan loop. Returns the
   197	    state dict on write, else None (deduped or error)."""
   198	    try:
   199	        now = _time.time()
   200	        with _LOCK:
   201	            if now - _LAST_LOG.get(asset, 0.0) < min_interval_s:
   202	                return None
   203	            _LAST_LOG[asset] = now
   204	        st = compute_tape_state(asset, now=now, **indicators)
   205	        _LAST_STATE[asset] = st  # in-memory cache for latest_tape_state() (no file re-read)
   206	        try:
   207	            _line = json.dumps(st) + "\n"
   208	            with _LOCK:  # serialize appends so concurrent asset lines never interleave
   209	                _CALIB_DIR.mkdir(parents=True, exist_ok=True)
   210	                with open(_MAP_PATH, "a") as fh:
   211	                    fh.write(_line)
   212	        except Exception:
   213	            return None
   214	        return st
   215	    except Exception:
   216	        return None
   217	
   218	
   219	def latest_tape_state(asset: str) -> Optional[dict]:
   220	    """Most-recent computed tape state for ``asset`` from the in-memory cache — a dict lookup,
   221	    NO file read (avoids the per-scan jsonl-reread that ballooned RSS). Returns None until the
   222	    first snapshot_and_log() for the asset this process. Fail-open."""
   223	    try:
   224	        return _LAST_STATE.get(asset)
   225	    except Exception:
   226	        return None
   227	
   228	
   229	def log_side_veto_shadow(**fields: Any) -> None:
   230	    """Observe-only: record what a tape-adaptive side-veto WOULD do (would_veto) for an entry,
   231	    without blocking it — so we can measure (offline, joined to the trade outcome) whether the
   232	    veto correctly catches wrong-direction entries before it is ever made active. Fail-silent."""
   233	    try:
   234	        fields.setdefault("ts", _time.time())
   235	        _line = json.dumps(fields) + "\n"
   236	        with _LOCK:
   237	            _CALIB_DIR.mkdir(parents=True, exist_ok=True)
   238	            with open(_VETO_SHADOW_PATH, "a") as fh:
   239	                fh.write(_line)
   240	    except Exception:
   241	        return None

