   100	    m5, m15, m1h = _macd_sign(macd_5m), _macd_sign(macd_15m), _macd_sign(macd_1h)
   101	    macd_net = m5 + m15 + m1h  # -3..3
   102	
   103	    # EMA stack direction (only when the full stack + price are present, e.g. alts; eth omits).
   104	    ema_dir = 0
   105	    cp, e9, e21, e50 = _f(current_price), _f(ema_9), _f(ema_21), _f(ema_50)
   106	    if None not in (cp, e9, e21, e50):
   107	        if cp > e21 > e50 and e9 >= e21:
   108	            ema_dir = 1
   109	        elif cp < e21 < e50 and e9 <= e21:
   110	            ema_dir = -1
   111	
   112	    # Assets without an EMA stack (e.g. BTC, which uses a sabre/MA trend instead) can supply a
   113	    # native MA-trend vote via aux_dir in {-1,0,1}. It fills the EMA-vote slot so they still get
   114	    # a 3rd direction vote (macd + MA-trend + htf) rather than just macd + htf — keeping the
   115	    # 3-term dscore and +/-2 threshold identical to the alts.
   116	    if ema_dir == 0 and aux_dir is not None:
   117	        ema_dir = _sign(_f(aux_dir))
   118	
   119	    # Explicit trend label when the service provides one.
   120	    td = str(trend_direction or "").upper()
   121	    td_dir = 1 if td in ("UP", "BULLISH") else (-1 if td in ("DOWN", "BEARISH") else 0)
   122	
   123	    strength = _f(trend_strength)
   124	    strength = max(0.0, min(1.0, strength)) if strength is not None else None
   125	
   126	    # Volatility: atr% + rolling percentile vs this asset's own recent history.
   127	    # Computed BEFORE the direction decision so a genuinely MOVING (high-vol) tape can override
   128	    # the stale-MACD "FLAT" tie via the lean-promotion below.
   129	    atr_pct = None
   130	    vol_pctile = None
   131	    vol_bucket = None
   132	    apct = _f(atr_14)
   133	    if apct is not None and cp not in (None, 0):
   134	        atr_pct = apct / cp
   135	        hist = _ATR_HIST[asset]
   136	        hist.append(atr_pct)
   137	        if len(hist) >= 5:
   138	            vol_pctile = round(sum(1 for h in hist if h <= atr_pct) / len(hist), 3)
   139	            vol_bucket = "high" if vol_pctile >= 0.70 else ("low" if vol_pctile <= 0.30 else "mid")
   140	
   141	    # Direction vote: MACD consensus + EMA stack + trend label, each in {-1,0,1}.
   142	    dscore = _sign(macd_net) + ema_dir + td_dir  # -3..3
   143	    vol_promoted = False
   144	    _votes = (_sign(macd_net), ema_dir, td_dir)
   145	    _lean = 1 if dscore > 0 else -1
   146	    _aligned = sum(1 for v in _votes if v == _lean)   # votes agreeing with the lean
   147	    _opposed = sum(1 for v in _votes if v == -_lean)  # votes against it
   148	    if dscore >= 2:
   149	        direction = "UP"
   150	    elif dscore <= -2:
   151	        direction = "DOWN"
   152	    elif (
   153	        _VOL_PROMOTE_ENABLED
   154	        and dscore in (-1, 1)
   155	        and vol_pctile is not None
   156	        and vol_pctile >= _VOL_PROMOTE_PCTILE
   157	        and _aligned >= 2          # a genuine 2-of-3 MAJORITY...
   158	        and _opposed >= 1          # ...dragged to +/-1 by ONE opposing (usually lagging) vote
   159	    ):
   160	        # HIGH-VOLATILITY MAJORITY-LEAN PROMOTION (Codex-guarded): only promote a 2-of-3
   161	        # majority that a single opposing vote (typically the lagging MACD) pulled down to
   162	        # dscore +/-1 — NOT a lone single-source lean (noise). Bitcoin's reversal
   163	        # [macd=+1, ema=-1, trend=-1] => lean=-1, aligned=2 (ema+trend), opposed=1 (stale
   164	        # macd) => DOWN. A weak [trend=-1, 0, 0] => aligned=1 => stays FLAT. Low-vol stays FLAT.
   165	        direction = "UP" if dscore > 0 else "DOWN"
   166	        vol_promoted = True
   167	    else:
   168	        direction = "FLAT"
   169	
   170	    # Confidence: how much the (nonzero) direction signals agree, blended with strength.
   171	    sigs = [s for s in (_sign(macd_net), ema_dir, td_dir) if s]
   172	    agree = (abs(sum(sigs)) / len(sigs)) if sigs else 0.0  # 1.0 = unanimous
   173	    conf = 0.6 * agree + 0.4 * (strength if strength is not None else 0.0)
