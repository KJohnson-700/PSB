from src.analysis import tape_map

# reset local rolling ATR hist for deterministic checks
asset='review_asset'
tape_map._ATR_HIST[asset].clear()

def seed(vals):
    tape_map._ATR_HIST[asset].clear()
    for v in vals:
        tape_map.compute_tape_state(asset, current_price=100, atr_14=v, trend_strength=1.0)

def st(**kw):
    return tape_map.compute_tape_state(asset, current_price=100, atr_14=10, trend_strength=1.0, now=1.0, **kw)

