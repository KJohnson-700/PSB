import yaml
from pathlib import Path
paths=['config/settings.yaml.bak_pre_B1_htfboost_20260720','config/settings.yaml']
keys=['take_profit_pct','updown_hold_winners_to_resolution','updown_trail_arm_pct','updown_trail_gap_pct','updown_stop_loss_pct','updown_stop_cents','updown_exit_window_mins','updown_exit_window_max_fraction','updown_in_profit_stop_trigger_pct','updown_in_profit_stop_tighten_to_pct']
for p in paths:
    data=yaml.safe_load(Path(p).read_text())
    print('\\n###',p)
    overrides=data.get('trading',{}).get('exit_rules',{}).get('strategy_overrides',{})
    for strat in ['bitcoin','sol_macro','eth_macro','hype_macro','xrp_macro','bnb_macro','doge_macro']:
        s=overrides.get(strat,{})
        print('\\n',strat,'asset', {k:s.get(k) for k in keys if k in s})
        w=s.get('window_lane_overrides',{}) or {}
        for win, sides in w.items():
            for side, vals in (sides or {}).items():
                selected={k:vals.get(k) for k in keys if k in vals}
                if selected:
                    print(f'  {win}|{side}: {selected}')
