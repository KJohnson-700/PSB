   510	    def _min_hold_floor_secs(self, pos) -> float:
   511	        """Per-window phantom-exit floor. Prefers the position's EXPLICIT
   512	        ``window_size`` (so a late 15m/1h entry with little runway left is NOT
   513	        misclassified as 5m); only falls back to inferring from
   514	        (end_date - opened_at) for legacy reloads with no window_size. Unknown /
   515	        missing window -> the scalar floor (the conservative 60s)."""
   516	        if not self._updown_min_hold_by_window:
   517	            return self._updown_min_hold_sec_before_pct_exit
   518	        label = infer_updown_window_size(
   519	            getattr(pos, "window_size", "") or "",
   520	            opened_at=getattr(pos, "opened_at", None),
   521	            end_date=getattr(pos, "end_date", None),
   522	        )
   523	        return self._updown_min_hold_by_window.get(
   524	            label, self._updown_min_hold_sec_before_pct_exit
   525	        )
   526	
   527	    def _window_keeps_early_stop(self, pos) -> bool:
   528	        """Whether this position's window still fires the early hold-lane cuts
   529	        (favorite_hard_stop + independent -catastrophic backstop). Default: 1h
   530	        only — 5m/15m ride to resolution because their mid-window drawdown is
   531	        recoverable noise (see reload_from_config note). "all" => every window;
   532	        empty set => none. Robust to a missing window_size via inference."""
   533	        ws = getattr(self, "_hold_early_stop_windows", None)
   534	        if ws is None or "all" in ws:
   535	            return True
   536	        label = infer_updown_window_size(
   537	            getattr(pos, "window_size", "") or "",
   538	            opened_at=getattr(pos, "opened_at", None),
   539	            end_date=getattr(pos, "end_date", None),
   540	        )
   541	        return str(label).lower() in ws
