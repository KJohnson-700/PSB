   274	def parse_updown_exit_globals(exit_cfg: Dict[str, Any]) -> UpdownExitGlobals:
   275	    """Parse ``trading.exit_rules`` subset used by crypto up/down exits."""
   276	    ec = exit_cfg or {}
   277	    _misplaced_late_tp = [k for k in ec if k in _LATE_TP_LANE_ONLY_KEYS]
   278	    if _misplaced_late_tp:
   279	        _warn_misplaced_late_tp(_misplaced_late_tp, "trading.exit_rules (top level)")
   280	    base_stop = float(ec.get("updown_stop_cents", 0.03) or 0.03)
   281	    base_win = float(ec.get("updown_exit_window_mins", 2.0) or 2.0)
   282	    base_hold = float(ec.get("updown_max_hold_mins", 20.0) or 20.0)
   283	    base_frac = float(ec.get("updown_exit_window_max_fraction", 0.5) or 0.5)
   284	    lane_overrides: Dict[str, Dict[str, float]] = {}
   285	    for lane, raw in (ec.get("updown_lane_overrides") or {}).items():
   286	        lane_overrides[str(lane)] = _normalize_override_map(raw)
   287	    return UpdownExitGlobals(
   288	        take_profit_pct=float(ec.get("take_profit_pct", 0.15) or 0.15),
   289	        updown_hold_winners_to_resolution=bool(
   290	            ec.get("updown_hold_winners_to_resolution", False)
   291	        ),
   292	        hold_5m_all=bool(ec.get("hold_5m_all", False)),
   293	        hold_5m_loser_floor_pct=float(ec.get("hold_5m_loser_floor_pct", 0.30) or 0.30),
   294	        hold_all=bool(ec.get("hold_all", False)),
   295	        updown_stop_loss_pct=float(ec.get("updown_stop_loss_pct", 0.20) or 0.20),
   296	        updown_stop_cents=base_stop,
   297	        updown_exit_window_mins=base_win,
   298	        updown_max_hold_mins=base_hold,
   299	        updown_exit_window_max_fraction=base_frac,
