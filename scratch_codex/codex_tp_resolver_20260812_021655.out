   231	
   232	def _normalize_override_map(raw: Any) -> Dict[str, Any]:
   233	    if not isinstance(raw, dict):
   234	        return {}
   235	    out: Dict[str, Any] = {}
   236	    for key in _UPDOWN_EXIT_PARAM_KEYS:
   237	        if key in raw:
   238	            out[key] = (
   239	                bool(raw[key])
   240	                if key == "updown_hold_winners_to_resolution"
   241	                else float(raw[key])
   242	            )
   243	    return out
   244	
   245	
   246	def _normalize_strategy_overrides(raw_overrides: Any) -> Dict[str, Dict[str, Any]]:
   247	    out: Dict[str, Dict[str, Any]] = {}
   248	    if not isinstance(raw_overrides, dict):
   249	        return out
   250	    for strategy, raw in raw_overrides.items():
   251	        if not isinstance(raw, dict):
   252	            continue
   253	        strategy_cfg: Dict[str, Any] = _normalize_override_map(raw)
   254	        lane_overrides: Dict[str, Dict[str, float]] = {}
   255	        for lane, lane_raw in (raw.get("lane_overrides") or {}).items():
   256	            lane_overrides[str(lane)] = _normalize_override_map(lane_raw)
   257	        if lane_overrides:
   258	            strategy_cfg["lane_overrides"] = lane_overrides
   259	        window_lane_overrides: Dict[str, Dict[str, Dict[str, float]]] = {}
   260	        for window, window_raw in (raw.get("window_lane_overrides") or {}).items():
   261	            if not isinstance(window_raw, dict):
   262	                continue
   263	            lane_map: Dict[str, Dict[str, float]] = {}
   264	            for lane, lane_raw in window_raw.items():
   265	                lane_map[str(lane)] = _normalize_override_map(lane_raw)
   266	            if lane_map:
   267	                window_lane_overrides[str(window)] = lane_map
   268	        if window_lane_overrides:
   269	            strategy_cfg["window_lane_overrides"] = window_lane_overrides
   270	        out[str(strategy)] = strategy_cfg
   271	    return out
