import yaml
from pathlib import Path
from src.execution.updown_exit_shared import parse_updown_exit_globals, resolve_updown_exit_params_for_position
for p in ['config/settings.yaml.bak_pre_B1_htfboost_20260720','config/settings.yaml']:
    data=yaml.safe_load(Path(p).read_text())
    g=parse_updown_exit_globals(data.get('trading',{}).get('exit_rules',{}))
    print('\\n###',p)
    print('hold_all', g.hold_all, 'hold_5m_all', g.hold_5m_all, 'global_tp', g.take_profit_pct)
    for strat,win,side in [('bitcoin','15m','down'),('bitcoin','1h','up'),('bitcoin','5m','up'),('xrp_macro','5m','up'),('xrp_macro','5m','down'),('xrp_macro','1h','up'),('xrp_macro','1h','down'),('hype_macro','5m','up'),('hype_macro','5m','down')]:
        entry_leg='NO' if side=='down' else 'YES'; outcome=entry_leg
        r=resolve_updown_exit_params_for_position(g,strategy_name=strat,window_size=win,entry_leg=entry_leg,outcome=outcome)
        print(f'{strat}|{win}|{side}: hold={r.updown_hold_winners_to_resolution} tp={r.take_profit_pct} stop={r.updown_stop_loss_pct} dyn={r.dynamic_stop_enabled} trail={r.updown_trail_arm_pct}/{r.updown_trail_gap_pct}')
