   342	
   343	def _parse_regime_conditioned_exits(raw: Any) -> Dict[str, Any]:
   344	    """Parse the optional ``regime_conditioned_exits`` block (all default-off)."""
   345	    rc = raw if isinstance(raw, dict) else {}
   346	    excl_raw = rc.get("exclude_lanes") or []
   347	    exclude = frozenset(
   348	        str(x or "").strip().lower() for x in excl_raw if str(x or "").strip()
   349	    )
   350	    return {
   351	        "regime_conditioned_exits_enabled": bool(rc.get("enabled", False)),
   352	        "rce_trend_hold_winners": bool(rc.get("trend_side_hold_winners", True)),
   353	        "rce_trend_trail_arm_pct": float(rc.get("trend_side_trail_arm_pct", 0.10) or 0.0),
   354	        "rce_trend_trail_gap_pct": float(rc.get("trend_side_trail_gap_pct", 0.15) or 0.0),
   355	        "rce_off_trend_force_tight": bool(rc.get("off_trend_force_tight", True)),
   356	        "rce_exclude": exclude,
   357	    }
   358	
   359	
   360	def _apply_regime_conditioned_exit(
   361	    params: Dict[str, Any],
   362	    *,
   363	    lane: str,
   364	    btc_1h_regime: Optional[str],
   365	    g: UpdownExitGlobals,
   366	    strategy_name: Any = None,
   367	    window: Any = None,
   368	) -> None:
   369	    """Override only the hold/trail keys in ``params`` from (side x regime).
   370	
   371	    No-op unless ``regime_conditioned_exits_enabled``. Trend-side (LONG in BULL,
   372	    SHORT in BEAR) gets hold+trail; counter-trend or chop/unknown regime is forced
   373	    to tight TP/SL (when ``rce_off_trend_force_tight``). Lanes in ``rce_exclude``
   374	    (by "strategy" or "strategy|window") are skipped entirely so they keep their
   375	    static config (e.g. pure take-profit). Mutates ``params`` in place.
   376	    """
   377	    if not g.regime_conditioned_exits_enabled:
   378	        return
   379	    if g.rce_exclude:
   380	        strat = str(strategy_name or "").strip().lower()
   381	        win = str(window or "").strip().lower()
   382	        if strat and (strat in g.rce_exclude or f"{strat}|{win}" in g.rce_exclude):
   383	            return
   384	    regime = str(btc_1h_regime or "").strip().upper()
   385	    ln = str(lane or "").strip().lower()
   386	    trend_side = (ln == "up" and regime == "BULL") or (ln == "down" and regime == "BEAR")
   387	    if trend_side:
   388	        params["updown_hold_winners_to_resolution"] = bool(g.rce_trend_hold_winners)
   389	        params["updown_trail_arm_pct"] = float(g.rce_trend_trail_arm_pct)
   390	        params["updown_trail_gap_pct"] = float(g.rce_trend_trail_gap_pct)
   391	    elif g.rce_off_trend_force_tight:
   392	        params["updown_hold_winners_to_resolution"] = False
   393	        params["updown_trail_arm_pct"] = 0.0
   394	        params["updown_trail_gap_pct"] = 0.0
   395	
   396	
   397	def resolve_updown_exit_params(
   398	    g: UpdownExitGlobals, strategy_name: str
   399	) -> Tuple[float, float, float, float]:
   400	    """Compatibility helper returning the legacy tuple shape."""
   401	    ov = g.updown_overrides.get(str(strategy_name), {}) if isinstance(g.updown_overrides, dict) else {}
   402	    return (
   403	        float(ov.get("updown_stop_cents", g.updown_stop_cents)),
   404	        float(ov.get("updown_exit_window_mins", g.updown_exit_window_mins)),
   405	        float(ov.get("updown_max_hold_mins", g.updown_max_hold_mins)),
   406	        float(ov.get("updown_exit_window_max_fraction", g.updown_exit_window_max_fraction)),
   407	    )
   408	
   409	
   410	def resolve_updown_lane(*, entry_leg: str, outcome: str) -> str:
   411	    leg = str(entry_leg or "YES").upper()
   412	    out = str(outcome or "YES").upper()
   413	    if leg == "NO" or out == "NO":
   414	        return "down"
   415	    return "up"
   416	
   417	
   418	def infer_updown_window_size(
   419	    window_size: Optional[str],
   420	    *,
   421	    opened_at: Optional[datetime] = None,
   422	    end_date: Optional[datetime] = None,
   423	) -> str:
   424	    w = str(window_size or "").strip().lower()
   425	    if w in {"5m", "15m", "30m", "1h"}:
   426	        return w
   427	    if opened_at is None or end_date is None:
   428	        return ""
   429	    start = opened_at
   430	    finish = end_date
   431	    if start.tzinfo is None:
   432	        start = start.replace(tzinfo=timezone.utc)
   433	    if finish.tzinfo is None:
   434	        finish = finish.replace(tzinfo=timezone.utc)
   435	    mins = (finish - start).total_seconds() / 60.0
   436	    rounded = int(round(mins))
   437	    if abs(mins - 5.0) <= 0.6 or rounded == 5:
   438	        return "5m"
   439	    if abs(mins - 15.0) <= 0.6 or rounded == 15:
   440	        return "15m"
   441	    if abs(mins - 30.0) <= 1.0 or rounded == 30:
   442	        return "30m"  # legacy: 30m product discontinued but historic positions persist
   443	    if abs(mins - 60.0) <= 2.0 or rounded == 60:
   444	        return "1h"
   445	    return ""
   446	
   447	
   448	def resolve_updown_exit_params_for_position(
