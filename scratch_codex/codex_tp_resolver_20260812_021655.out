   220	      * strategy_cfg.lane_overrides[lane]               -> one strategy, ALL windows
   221	    The original guard only filtered the strategy level, so a top-level
   222	    `trading.exit_rules.take_profit_late_pct` still reached every lane.
   223	    """
   224	    if not isinstance(overrides, dict):
   225	        return {}
   226	    dropped = [k for k in overrides if k in _LATE_TP_LANE_ONLY_KEYS]
   227	    if dropped:
   228	        _warn_misplaced_late_tp(dropped, where)
   229	    return {k: v for k, v in overrides.items() if k not in _LATE_TP_LANE_ONLY_KEYS}
