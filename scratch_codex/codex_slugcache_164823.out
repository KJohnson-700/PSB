   134	
   135	def _coerce_json_list(raw: Any) -> List[Any]:
   136	    """Accept Gamma list-like fields serialized as JSON strings or arrays."""
   137	    if isinstance(raw, list):
   138	        return raw
   139	    if raw is None:
   140	        return []
   141	    if isinstance(raw, str):
   142	        payload = raw.strip()
   143	        if not payload:
   144	            return []
   145	        try:
   146	            parsed = json.loads(payload)
   147	        except Exception:
   148	            return []
   149	        return parsed if isinstance(parsed, list) else []
   150	    return []
   151	
   152	
   153	def is_tradably_priced(market) -> bool:
   154	    """Single source of truth for 'this market has a REAL, tradable quote'.
   155	
   156	    Fail-CLOSED: a market is tradable only if a real mid was applied
   157	    (``price_hydrated`` set True by ``update_market_prices``) AND ``yes_price``
   158	    is a real number. Markets that bypassed hydration (just-opened books with no
   159	    /midpoint yet) keep the fail-closed default and are rejected here, so no
   160	    strategy can fabricate phantom edge against the 0.5 default. Used by the
   161	    scanner ``_priced`` filter and every macro-strategy entry filter so the guard
   162	    is uniform across all 7 assets (2026-06-22 contamination fix).
   163	    """
   164	    if not getattr(market, "price_hydrated", False):
   165	        return False
   166	    yp = getattr(market, "yes_price", None)
   167	    return yp is not None
   168	
   169	
   170	def _parse_updown_window_minutes_from_text(text: str) -> Optional[int]:
   171	    """Return the explicit Up/Down candle length from a market title/range."""
   172	    time_match = _UPDOWN_TIME_RANGE_RE.search(text or "")
   173	    if not time_match:
   174	        return None
   175	    h1, m1, p1, h2, m2, p2 = time_match.groups()
   176	    start_period = (p1 or p2 or "").upper()
   177	    end_period = (p2 or p1 or "").upper()
   178	    try:
   179	        start_hour = int(h1)
   180	        start_minute = int(m1)
   181	        end_hour = int(h2)
   182	        end_minute = int(m2)
   183	    except (TypeError, ValueError):
   184	        return None
   185	
   186	    def _to_24h(hour: int, period: str) -> int:
   187	        if period == "PM" and hour != 12:
   188	            return hour + 12
   189	        if period == "AM" and hour == 12:
   190	            return 0
   191	        return hour
   192	
   193	    start_total = _to_24h(start_hour, start_period) * 60 + start_minute
   194	    end_total = _to_24h(end_hour, end_period) * 60 + end_minute
   195	    diff = end_total - start_total
   196	    if diff <= 0:
   197	        diff += 24 * 60
   198	    return diff
   199	
   200	
   201	def _dedupe_markets_by_id(markets: List[Market]) -> List[Market]:
   202	    seen: set[str] = set()
   203	    out: List[Market] = []
   204	    for m in markets:
   205	        mid = (m.id or "").strip()
   206	        if not mid or mid in seen:
   207	            continue
   208	        seen.add(mid)
   209	        out.append(m)
   210	    return out
   211	
   212	
   213	def _drop_expired_markets(
   214	    markets: List[Market], *, now: Optional[datetime] = None
   215	) -> Tuple[List[Market], int]:
   216	    """Remove markets whose ``end_date`` is already in the past (untradeable).
   217	
   218	    Fast crypto up/down markets keep reporting ``active=true closed=false`` in
   219	    Gamma for a window AFTER they resolve, so without this guard already-expired
   220	    windows (e.g. a 2:40AM market still in the set at 7AM) flow into the scan.
   221	    Each one then costs a /midpoint price-fetch + microstructure enrich + a full
   222	    per-lane TA pass every cycle — the backlog grows through the day and is what
   223	    balloons scanner_sync. Expired == untradeable, so this is pure dead-weight
   224	    removal (the strategies already require positive minutes-left to enter, so no
   225	    real entry is lost). Markets with no parsed ``end_date`` are kept (unknown).
   226	    """
   227	    if not markets:
   228	        return markets, 0
   229	    ref = now or datetime.now(timezone.utc)
   230	    kept: List[Market] = []
   231	    dropped = 0
   232	    for m in markets:
   233	        ed = getattr(m, "end_date", None)
   234	        if ed is not None:
   235	            if ed.tzinfo is None:
   236	                ed = ed.replace(tzinfo=timezone.utc)
   237	            if ed <= ref:
   238	                dropped += 1
   239	                continue
   240	        kept.append(m)
   241	    return kept, dropped
   242	
   243	
   244	def is_crypto_updown_market(market: Market) -> bool:
   245	    """True for crypto up/down candle markets (bitcoin/sol_macro/eth_macro), not price-threshold markets."""

