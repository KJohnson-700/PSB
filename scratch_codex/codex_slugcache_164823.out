    67	    # Parsed candle duration for crypto Up/Down event markets. Current Gamma
    68	    # hourly markets use the same question shape as old short-window markets, so
    69	    # strategy buckets must not infer 5m/15m from asset name alone.
    70	    window_minutes: Optional[int] = None
    71	    # Microstructure features (2026-06-09) — populated by the optional
    72	    # MarketScanner.enrich_microstructure step (default-off). None = not enriched.
    73	    # The hunt for a signal the TA stack lacks: order-book imbalance (resting
    74	    # depth) + trade flow (executed taker pressure). Logged on candidates to
    75	    # forward-validate whether they separate winners from losers.
    76	    ob_imbalance: Optional[float] = None
    77	    trade_flow_ratio: Optional[float] = None
    78	    # True once a REAL price (WS push or REST /midpoint) was applied. False means
    79	    # yes_price/no_price are the 0.5 DEFAULT — the market is unpriced and MUST NOT be
    80	    # traded (a 0.5 default fabricates phantom edge vs est_prob => blind entries).
    81	    # 2026-06-22: default FLIPPED True->False (fail-CLOSED). A market is unpriced
    82	    # until update_market_prices() applies a real mid; any market that bypasses
    83	    # hydration (e.g. just-opened BTC books with no /midpoint yet) now stays
    84	    # untradable instead of trading the fabricated 0.5. Test/manual Market objects
    85	    # that need to be tradable must set price_hydrated=True explicitly.
    86	    price_hydrated: bool = False
    87	    # True when only ONE leg's midpoint returned and the other was DERIVED as
    88	    # 1 - present_leg (see update_market_prices). The derived leg is a synthetic
    89	    # complementary midpoint, not an independently observed/executable quote — treat
    90	    # accordingly in any audit or live-fill provenance.
    91	    price_one_sided_derived: bool = False
    92	
    93	    @property
    94	    def is_binary(self) -> bool:
    95	        """Check if market is binary"""
    96	        return self.yes_price + self.no_price > 0.98
    97	    
    98	    @property
    99	    def hours_to_expiration(self) -> Optional[float]:
   100	        """Calculate hours until market expiration"""
   101	        if not self.end_date:
   102	            return None
   103	        end = self.end_date
   104	        if end.tzinfo is not None:
   105	            now = datetime.now(timezone.utc)
   106	            if end.tzinfo is not timezone.utc:
   107	                end = end.astimezone(timezone.utc)
   108	        else:
   109	            now = datetime.now()
   110	        delta = end - now
   111	        return delta.total_seconds() / 3600
   112	
   113	
   114	# Matches BTC / SOL / ETH short-candle "Up or Down" questions (15m / 5m windows).
   115	_CRYPTO_ASSET_UPDOWN_PATTERN = re.compile(
   116	    r"(?:(?:bitcoin|btc)|(?:solana|sol)|(?:ethereum|eth|ether)|(?:ripple|xrp)|(?:hyperliquid|hype)|(?:dogecoin|doge)|(?:bnb|binance\s+coin))\s+up\s+or\s+down",
   117	    re.IGNORECASE,
   118	)
   119	# Slug prefix from Gamma event slugs (5m / 15m updown).
   120	_CRYPTO_UPDOWN_SLUG_RE = re.compile(
   121	    r"(?:btc|sol|eth|xrp|hype|doge|bnb)-updown-(?:5m|15m|30m)-", re.IGNORECASE
   122	)
   123	_HYPE_ALT_UPDOWN_SLUG_RE = re.compile(
   124	    r"(?:hyperliquid-up-or-down|hype-up-or-down)-", re.IGNORECASE
   125	)
   126	_UPDOWN_SLUG_DATE_RE = re.compile(
   127	    r"up-or-down-([a-z]+)-(\d{1,2})-(\d{4})-", re.IGNORECASE
   128	)
   129	_UPDOWN_TIME_RANGE_RE = re.compile(
   130	    r"(\d{1,2}):(\d{2})\s*(AM|PM)?\s*[–-]\s*(\d{1,2}):(\d{2})\s*(AM|PM)",
   131	    re.IGNORECASE,
   132	)
