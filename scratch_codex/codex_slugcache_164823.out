   335	    if not slug_match:
   336	        return None
   337	    month_name, day_s, year_s = slug_match.groups()
   338	    try:
   339	        month = datetime.strptime(month_name[:3], "%b").month
   340	        day = int(day_s)
   341	        year = int(year_s)
