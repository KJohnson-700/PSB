   659	    def _order_assets(self, assets: Tuple[str, ...], offset: int) -> List[str]:
   660	        """Two-phase adaptive ordering (Codex-scoped, guarded).
   661	
   662	        COVERAGE: the nearest window (offset 0) ALWAYS keeps canonical order, so every
   663	        enabled asset gets its most-tradeable window fetched first each cycle. PRIORITY:
   664	        deeper lookahead (offset>=1) is ordered by EMA productivity DESC (stable ties ->
   665	        canonical), so the inner-fetch timeout cuts unproductive deep-lookahead tails,
   666	        never a producer's near window. ESCAPE HATCH: every Nth cycle reverts to canonical
   667	        to avoid long-term bias. Off / empty productivity / cold-start => canonical
   668	        (byte-identical to today). This is priority BIAS, never asset suppression.
   669	        """
   670	        assets = list(assets)
   671	        if (
   672	            offset <= 0
   673	            or not self._adaptive_slug_order_enabled()
   674	            or not self._asset_productivity
   675	        ):
   676	            return assets
   677	        esc = self._adaptive_escape_every_n()
   678	        if esc > 0 and (self._scan_cycle_seq % esc) == 0:
   679	            return assets
   680	        prod = self._asset_productivity
   681	        return sorted(assets, key=lambda a: -float(prod.get(_asset_key(a), 0.0)))
