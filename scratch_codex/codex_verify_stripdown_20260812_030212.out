from pathlib import Path
import yaml
files=['config/settings.yaml','config/settings.yaml.bak_pre_resolver_stripdown_030145','config/settings.yaml.bak_pre_B1_htfboost_20260720']
keys=[
('regime_fade.enabled',['regime_fade','enabled']),
('direction.enforce',['direction','enforce']),
('strategies.eth_macro.eth_momentum_confirm.buy_yes',['strategies','eth_macro','eth_momentum_confirm','buy_yes']),
('strategies.eth_macro.eth_momentum_confirm.buy_no',['strategies','eth_macro','eth_momentum_confirm','buy_no']),
]
# find buy_no_tape_map_veto_up locations recursively
for f in files:
    data=yaml.safe_load(Path(f).read_text())
    print('\\n##',f)
    for label,path in keys:
        cur=data
        for p in path:
            cur=cur[p]
        print(f'{label}: {cur"'!r}'"')
    found=[]
    def walk(obj,path=()):
        if isinstance(obj,dict):
            for k,v in obj.items():
                if k=='buy_no_tape_map_veto_up': found.append(('.'.join(path+(k,)),v))
                walk(v,path+(str(k),))
        elif isinstance(obj,list):
            for i,v in enumerate(obj): walk(v,path+(str(i),))
    walk(data)
    for p,v in found:
        print(f'{p}: {v"'!r}'"')
