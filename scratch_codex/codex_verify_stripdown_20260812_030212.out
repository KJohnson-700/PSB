  1484	    def _bias_to_side(self, bias: str, tf: Optional[str] = None, aligned: bool = False) -> Optional[str]:
  1485	        # Primary regime->side mapping used by _resolve_alt_bias_for_tf (the live
  1486	        # side-decision path for all alts + ETH). COUNTER-REGIME (fade) mode —
  1487	        # 2026-06-22, default OFF: OOS ghost (347k settled, both time-halves) showed
  1488	        # WITH-regime/momentum edge -1.5%/-2.5% vs COUNTER-regime/fade +2.7%/+3.7%.
  1489	        # When config fade_regime=true, invert so the strategy fades the regime.
  1490	        # Fail-safe: missing/false flag => byte-identical momentum behaviour.
  1491	        if bias == "BULLISH":
  1492	            base = "LONG"
  1493	        elif bias == "BEARISH":
  1494	            base = "SHORT"
  1495	        else:
  1496	            # NEUTRAL: quant sits out. The direction-override seam may still supply a
  1497	            # side (ONLY when direction.override_when_quant_neutral). Default => None.
  1498	            return self._apply_direction_override(None, tf)
  1499	        # 2026-06-27 per-lane fade: fade ONLY on enabled windows (fade_regime_windows)
  1500	        # AND when the timeframes DISAGREE (not a fully-aligned trend). The fade edge is
  1501	        # per alt x window (5m universal +EV; xrp/hype 1h +EV; bnb/doge 1h -EV) and lives
  1502	        # in chop/disagreement — fading a fully-aligned strong trend gets run over (the
  1503	        # live sol 5m fully-aligned losses). aligned=True suppresses the fade.
  1504	        if self._fade_for_window(tf) and not aligned:
  1505	            quant_side = "SHORT" if base == "LONG" else "LONG"
  1506	        else:
  1507	            quant_side = base
  1508	        # Direction-override seam (default quant; SHADOW unless direction.enforce=true).
  1509	        return self._apply_direction_override(quant_side, tf)
