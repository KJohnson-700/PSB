     1	"""
     2	Direction-override seam — lets an EXTERNAL decider pick the trade side, with the
     3	quant resolver as fallback. Two deciders:
     4	
     5	  * ``claude``  — a manual override file that Claude Code (via a terminal or the chat
     6	                  session) writes. This is the operator-selected mechanism: human/Claude
     7	                  in the loop, decided live.
     8	  * ``ai``      — the model_factory engine (minimax_tape / qwen / ...) picks the side.
     9	                  Wired but INERT in v1 (returns quant fallback) until the engine call is
    10	                  added; the seam is complete so flipping it on later is config-only.
    11	
    12	DESIGN — safety first (this rides on the live money path):
    13	  * DEFAULT is quant. The ONLY way a side changes is ``mode != quant`` AND ``enforce: true``.
    14	  * With ``enforce: false`` (SHADOW) the seam only LOGS what it *would* do and returns the
    15	    quant side unchanged — so we score it before it drives a single trade.
    16	  * Every step is fail-safe: a missing/stale/malformed override, a bad config, a read
    17	    error — any of them returns the quant side untouched. This module must never raise
    18	    into the strategy and never block a trade.
    19	
    20	CONFIG (``config/settings.yaml`` top-level ``direction:`` block — hot-reloadable):
    21	
    22	    direction:
    23	      mode: quant            # quant | claude | ai
    24	      enforce: false         # false = SHADOW (log only, never change the side)
    25	      override_file: data/runtime/claude_direction_override.json
    26	      max_age_sec: 900       # override staleness cutoff (belt; each entry also has its own ttl)
    27	      override_when_quant_neutral: false   # let an override supply a side when quant sat out (None)
    28	      min_conf: 0.0          # ignore overrides whose conf is below this
    29	
    30	OVERRIDE FILE schema (written by ``scripts/claude_direction.py`` or by hand):
    31	
    32	    {
    33	      "sol_macro:15m": {"side": "SHORT", "conf": 0.8, "ts": 1733600000, "ttl": 900, "why": "..."},
    34	      "hype_macro":    {"side": "LONG",  "conf": 0.7, "ts": 1733600000},    # asset-wide (any tf)
    35	      "*":             {"side": "SHORT", "conf": 0.6, "ts": 1733600000}      # global default
    36	    }
    37	
    38	  Key resolution (most specific first): ``<asset>:<tf>`` -> ``<asset>`` -> ``*``.
    39	  First key that exists AND is fresh wins. ``side`` is LONG / SHORT (case-insensitive);
    40	  ``FLAT`` / ``NONE`` / ``SKIP`` means "sit out" (returns None).
    41	"""
    42	
    43	from __future__ import annotations
    44	
    45	import json
    46	import logging
    47	import os
    48	import time
    49	from typing import Any, Dict, Optional, Tuple
    50	
    51	logger = logging.getLogger(__name__)
    52	
    53	_DEFAULT_OVERRIDE_FILE = "data/runtime/claude_direction_override.json"
    54	_DEFAULT_MAX_AGE_SEC = 900.0
    55	
    56	# mtime-cached parse of the override file so we re-read only when it changes.
    57	_cache: Dict[str, Any] = {"path": None, "mtime": None, "data": {}}
    58	
    59	
    60	def _load_overrides(path: str) -> Dict[str, Any]:
    61	    """Read + parse the override JSON, cached by mtime. Fail-safe: {} on any problem."""
    62	    try:
    63	        st = os.stat(path)
    64	    except OSError:
    65	        # No file => no overrides. Reset cache so a later-created file is picked up.
    66	        if _cache["path"] == path and _cache["data"]:
    67	            _cache.update({"mtime": None, "data": {}})
    68	        return {}
    69	    if _cache["path"] == path and _cache["mtime"] == st.st_mtime:
    70	        return _cache["data"]
    71	    try:
    72	        with open(path, "r") as fh:
    73	            data = json.load(fh)
    74	        if not isinstance(data, dict):
    75	            data = {}
    76	    except Exception as exc:  # malformed / partial write / permission
    77	        logger.debug("direction_override: unreadable override file %s: %s", path, exc)
    78	        data = {}
    79	    _cache.update({"path": path, "mtime": st.st_mtime, "data": data})
    80	    return data
    81	
    82	
    83	def _norm_side(raw: Any) -> Optional[str]:
    84	    """LONG/SHORT (normalized) or None for sit-out / unrecognized."""
    85	    if raw is None:
    86	        return None
    87	    s = str(raw).strip().upper()
    88	    if s in ("LONG", "BUY_YES", "YES", "UP"):
    89	        return "LONG"
    90	    if s in ("SHORT", "BUY_NO", "NO", "DOWN"):
    91	        return "SHORT"
    92	    # FLAT / NONE / SKIP / anything else => sit out
    93	    return None
    94	
    95	
    96	def _entry_fresh(entry: Dict[str, Any], now: float, max_age: float) -> bool:
    97	    ts = entry.get("ts")
    98	    if ts is None:
    99	        # No timestamp => treat as fresh (hand-written entries); the belt max_age can't
   100	        # judge it, so we honor it. Prefer writing ts via the CLI.
   101	        return True
   102	    try:
   103	        ts = float(ts)
   104	    except (TypeError, ValueError):
   105	        return False
   106	    age = now - ts
   107	    if age < 0:
   108	        age = 0.0
   109	    ttl = entry.get("ttl")
   110	    try:
   111	        ttl = float(ttl) if ttl is not None else max_age
   112	    except (TypeError, ValueError):
   113	        ttl = max_age
   114	    return age <= min(ttl, max_age) if ttl and max_age else age <= (ttl or max_age)
   115	
   116	
   117	def _lookup(
   118	    overrides: Dict[str, Any], strategy: str, tf: Optional[str], now: float, max_age: float
   119	) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
   120	    """Return (entry, matched_key) for the most specific fresh override, else (None, None)."""
   121	    keys = []
   122	    if tf:
   123	        keys.append(f"{strategy}:{tf}")
   124	    keys.append(strategy)
   125	    keys.append("*")
   126	    for k in keys:
   127	        entry = overrides.get(k)
   128	        if isinstance(entry, dict) and _entry_fresh(entry, now, max_age):
   129	            return entry, k
   130	    return None, None
   131	
   132	
   133	def resolve(strategy: str, tf: Optional[str], quant_side: Optional[str], config: Any) -> Optional[str]:
   134	    """Entry point called from ``_bias_to_side``.
   135	
   136	    Returns the side the strategy should use. With the default config (no ``direction``
   137	    block, or mode=quant) this returns ``quant_side`` unchanged and does nothing.
   138	
   139	    ``quant_side`` is the strategy's own resolved side ("LONG" / "SHORT" / None).
   140	    """
   141	    try:
   142	        get = config.get if hasattr(config, "get") else (lambda k, d=None: d)
   143	        dcfg = get("direction", {}) or {}
   144	        if not isinstance(dcfg, dict):
   145	            return quant_side
   146	        mode = str(dcfg.get("mode", "quant") or "quant").lower()
   147	        if mode == "quant":
   148	            return quant_side
   149	
   150	        path = str(dcfg.get("override_file", _DEFAULT_OVERRIDE_FILE) or _DEFAULT_OVERRIDE_FILE)
   151	        max_age = float(dcfg.get("max_age_sec", _DEFAULT_MAX_AGE_SEC) or _DEFAULT_MAX_AGE_SEC)
   152	        min_conf = float(dcfg.get("min_conf", 0.0) or 0.0)
   153	        allow_neutral = bool(dcfg.get("override_when_quant_neutral", False))
   154	        enforce = bool(dcfg.get("enforce", False))
   155	
   156	        override_side: Optional[str] = None
   157	        conf: Optional[float] = None
   158	        matched_key: Optional[str] = None
   159	        why: str = ""
   160	
   161	        if mode == "claude":
   162	            now = time.time()
   163	            entry, matched_key = _lookup(_load_overrides(path), strategy, tf, now, max_age)
   164	            if entry is not None:
   165	                conf = entry.get("conf")
   166	                try:
   167	                    conf = float(conf) if conf is not None else None
   168	                except (TypeError, ValueError):
   169	                    conf = None
   170	                if conf is None or conf >= min_conf:
   171	                    override_side = _norm_side(entry.get("side"))
   172	                    why = str(entry.get("why", ""))[:80]
   173	        elif mode == "ai":
   174	            # Seam reserved for the model_factory engine (minimax_tape / qwen / ...).
   175	            # INERT in v1: no engine call yet, so we fall back to quant. Wiring the engine
   176	            # here is the only change needed to turn on automated AI-drive.
   177	            logger.debug("direction_override: mode=ai not yet wired; quant fallback strat=%s", strategy)
   178	            return quant_side
   179	        else:
   180	            return quant_side
   181	
   182	        # No usable override for this lane => quant.
   183	        if override_side is None and not (allow_neutral and matched_key is not None):
   184	            return quant_side
   185	        # If quant sat out (None) and we're not allowed to trade on neutral => quant (None).
   186	        if quant_side is None and not allow_neutral:
   187	            return quant_side
   188	
   189	        differs = override_side != quant_side
   190	        applied = enforce and differs
   191	        if differs:
   192	            logger.info(
   193	                "DIRECTION_OVERRIDE strat=%s tf=%s quant=%s override=%s conf=%s mode=%s "
   194	                "key=%s enforce=%s applied=%s why=%s",
   195	                strategy, tf, quant_side, override_side, conf, mode,
   196	                matched_key, enforce, applied, why,
   197	            )
   198	        return override_side if applied else quant_side
   199	    except Exception as exc:  # absolute belt — never raise into the strategy
   200	        logger.debug("direction_override: fail-safe quant (strat=%s): %s", strategy, exc)
   201	        return quant_side

