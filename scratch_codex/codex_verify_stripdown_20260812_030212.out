from pathlib import Path
import yaml
cur=yaml.safe_load(Path('config/settings.yaml').read_text())
# enumerate true-ish blunt side/global gate keywords in current config
keywords=('enforce','require','disable','veto','block','fade')
for strat,cfg in sorted((cur.get('strategies') or {}).items()):
    if not isinstance(cfg,dict): continue
    hits=[]
    def walk(o,path=()):
        if isinstance(o,dict):
            for k,v in o.items():
                walk(v,path+(str(k),))
        elif isinstance(o,(bool,int,float,str,list,type(None))):
            key='.'.join(path)
            if any(w in key for w in keywords):
                if o is True or (isinstance(o,list) and o) or (isinstance(o,(int,float)) and not isinstance(o,bool) and o"'!=0):
                    hits.append((key,o))
    walk(cfg)
    if strat in ['"'sol_macro','eth_macro','hype_macro','xrp_macro','doge_macro','bnb_macro','bitcoin']:
        print('\\n##',strat)
        for k,v in hits[:120]:
            print(f'{k}: {v"'!r}'"')
