  1252	    def _resolve_allowed_side_with_ltf_overrides(
  1253	        self, ta: Any, primary_htf_bias: str
  1254	    ) -> tuple[Optional[str], str, str]:
  1255	        """Additive-only side resolver — defaults always fire, exceptions are opt-in.
  1256	
  1257	        Returns (side, side_source, detail). For BULLISH/BEARISH inputs, side is never None;
  1258	        defaults are byte-identical to pre-resolver behavior. The only behavior change is
  1259	        that an opposite-trend LTF momentum break can flip the side to its exception path.
  1260	
  1261	        Paths:
  1262	          - BULL default LONG — always fires (no LTF gate).
  1263	          - BULL → SHORT exception — bearish_dip_ltf_ok AND NOT bullish_rally_ltf_ok.
  1264	            Clash rule: buy_no cannot fire when bullish rally also confirms (preserves rally LONG).
  1265	          - BEAR default SHORT — always fires (no LTF gate).
  1266	          - BEAR → LONG exception — bullish_rally_ltf_ok AND NOT bearish_dip_ltf_ok.
  1267	            Symmetric clash rule: BEAR-rally LONG only when bearish dip is absent.
  1268	        """
  1269	        bullish_ok, bullish_reason = self._bullish_rally_ltf_ok(ta)
  1270	        bearish_ok, bearish_reason = self._bearish_dip_ltf_ok(ta)
  1271	
  1272	        if primary_htf_bias == "BULLISH":
  1273	            if bearish_ok and not bullish_ok:
  1274	                return "SHORT", "bearish_dip_exception", bearish_reason
  1275	            return "LONG", "bullish_rally_default", f"default_long: bullish={bullish_ok} bearish={bearish_ok}"
  1276	
  1277	        if primary_htf_bias == "BEARISH":
  1278	            if bullish_ok and not bearish_ok:
  1279	                return "LONG", "bullish_rally_exception", bullish_reason
  1280	            return "SHORT", "bearish_dip_default", f"default_short: bullish={bullish_ok} bearish={bearish_ok}"
  1281	
  1282	        return None, "skip", "neutral_htf_no_resolver"
