   414	    def _is_solana_market(self, market: Market) -> bool:
   415	        text = (
   416	            f"{market.question} {market.description} "
   417	            f"{market.group_item_title} {market.slug}"
   418	        ).lower()
   419	        has_eth = any(p.search(text) for p in ETH_PATTERNS) or (market.slug or "").lower().startswith(ETH_UPDOWN_SLUG_PREFIXES)
   420	        if not has_eth:
   421	            return False
   422	        if any(term in text for term in NON_ETH_ASSET_TERMS):
   423	            primary = f"{market.question} {market.group_item_title} {market.slug}".lower()
   424	            if not any(p.search(primary) for p in ETH_PATTERNS):
   425	                return False
   426	        return True
   427	
   428	    def _is_updown_market(self, market: Market) -> bool:
   429	        slug = (market.slug or "").lower()
   430	        if slug.startswith(ETH_UPDOWN_SLUG_PREFIXES):
   431	            return True
   432	        text = f"{market.question} {market.group_item_title}"
   433	        return bool(ETH_UPDOWN_PATTERN.search(text))
