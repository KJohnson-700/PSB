  2956	    def _check_macd_confirmation(self, macd: Any, allowed_side: str, label: str = "15m") -> tuple:
  2957	        """Check if the given-timeframe MACD confirms the allowed direction.
  2958	
  2959	        Horizon-agnostic: callers pass the MACD for the candidate's own timeframe
