     1	#!/usr/bin/env python3
     2	"""side_resolver_v2 — single-owner side resolver (DETERMINISTIC, observe-only shadow).
     3	
     4	Per Codex design 2026-08-06. The champion resolver stacks override stages (native -> htf ->
     5	fresh-cross -> fade -> window-delta -> quant-flip) with NO single owner; measured right-side% is
     6	~coinflip (clean Binance-truth ledger: bot 50.8%, eth 43%). v2 produces ONE decision with ONE named
     7	owner and an auditable precedence, so we can measure whether a single-owner policy beats the champion
     8	on realized right-side% BEFORE any live wiring.
     9	
    10	This module is PURE (features in -> decision out), no I/O, no trading side effects. The shadow daemon
    11	(scripts/side_resolver_v2_shadow.py) feeds it candidate features and logs champion-vs-v2 for the
    12	Binance-truth scorer. Nothing here changes live behavior.
    13	
    14	Precedence (highest first) — justified by the clean ledger:
    15	  1. lane_tape_adapter   — realized per-(asset,window,side) edge says one side clearly earns admission
    16	  2. tape_map            — current tape directional AND not contradicted by realized adapter
    17	  3. quant              — quant decisive AND tape not opposing (never BTC-driven for an alt)
    18	  4. fresh_cross        — fresh own-asset cross, tape/adapter not opposing
    19	  5. mean_reversion     — lane-approved fade only (RSI extreme, not unanimous trend)
    20	  6. native             — fallback only (native owns 88% today but is ~coinflip -> demote to default)
    21	  7. sit_out            — the only available side comes from known-bad disagreement -> abstain
    22	"""
    23	from __future__ import annotations
    24	
    25	from dataclasses import dataclass, field
    26	from typing import Optional, Dict, Any
    27	
    28	
    29	@dataclass(frozen=True)
    30	class SideResolverFeatures:
    31	    strategy: str
    32	    asset: str
    33	    window: str
    34	    market_id: str
    35	    native_bias: str = "NEUTRAL"          # BULLISH / BEARISH / NEUTRAL
    36	    native_side: Optional[str] = None      # LONG / SHORT
    37	    htf_bias: str = "NEUTRAL"
    38	    htf_side: Optional[str] = None
    39	    quant_side: Optional[str] = None
    40	    momentum_side: Optional[str] = None
    41	    fresh_cross_side: Optional[str] = None
    42	    overbought: bool = False
    43	    oversold: bool = False
    44	    rsi_14: Optional[float] = None
    45	    tape_dir: Optional[str] = None         # UP / DOWN / FLAT
    46	    tape_conf: Optional[float] = None
    47	    tape_adapter_up: float = 0.0           # realized edge for LONG on this lane
    48	    tape_adapter_down: float = 0.0         # realized edge for SHORT on this lane
    49	    champion_side: Optional[str] = None
    50	    champion_side_source: str = ""
    51	    champion_resolver_path: Optional[str] = None
    52	
    53	
    54	@dataclass(frozen=True)
    55	class SideResolverDecision:
    56	    side: Optional[str]      # LONG / SHORT / None (abstain)
    57	    owner: str               # single owner responsible
    58	    confidence: float        # 0..1 ordinal (NOT a sizing input in phase 1)
    59	    why: str
    60	
    61	
    62	# tunables (kept explicit; a promotion pass can sweep these per-lane)
    63	_ADAPTER_EDGE_MIN = 0.04       # realized adapter delta that "clearly earns" a side
    64	_ADAPTER_DEADBAND = 0.01       # tape owner needs adapter not losing by more than this
    65	_RSI_OVERBOUGHT = 68.0
    66	_RSI_OVERSOLD = 32.0
    67	
    68	
    69	def _dir_to_side(d: Optional[str]) -> Optional[str]:
    70	    if d == "UP":
    71	        return "LONG"
    72	    if d == "DOWN":
    73	        return "SHORT"
    74	    return None
    75	
    76	
    77	def resolve_side_v2(f: SideResolverFeatures) -> SideResolverDecision:
    78	    up_edge, dn_edge = float(f.tape_adapter_up), float(f.tape_adapter_down)
    79	    tape_side = _dir_to_side(f.tape_dir)
    80	
    81	    # 1. lane_tape_adapter — realized edge clearly favors one side, the other doesn't
    82	    if max(up_edge, dn_edge) >= _ADAPTER_EDGE_MIN and abs(up_edge - dn_edge) >= _ADAPTER_EDGE_MIN:
    83	        side = "LONG" if up_edge > dn_edge else "SHORT"
    84	        conf = min(1.0, 0.6 + abs(up_edge - dn_edge))
    85	        return SideResolverDecision(side, "lane_tape_adapter", conf,
    86	                                    f"adapter up={up_edge:+.3f} dn={dn_edge:+.3f}")
    87	
    88	    # 2. tape_map — tape directional and realized adapter not contradicting it
    89	    if tape_side and f.tape_dir in ("UP", "DOWN"):
    90	        adapter_for = up_edge if tape_side == "LONG" else dn_edge
    91	        adapter_against = dn_edge if tape_side == "LONG" else up_edge
    92	        if adapter_for >= adapter_against - _ADAPTER_DEADBAND:
    93	            conf = min(1.0, 0.55 + float(f.tape_conf or 0.0) * 0.3)
    94	            return SideResolverDecision(tape_side, "tape_map", conf,
    95	                                        f"tape={f.tape_dir} conf={f.tape_conf} adapter_ok")
    96	
    97	    # 3. quant — decisive and tape not opposing; never BTC-derived for an alt
    98	    if f.quant_side in ("LONG", "SHORT"):
    99	        tape_opposes = tape_side is not None and tape_side != f.quant_side
   100	        if not tape_opposes:
   101	            return SideResolverDecision(f.quant_side, "quant", 0.55,
   102	                                        f"quant={f.quant_side} tape_not_opposing")
   103	
   104	    # 4. fresh_cross — fresh own-asset cross, tape/adapter not opposing
   105	    if f.fresh_cross_side in ("LONG", "SHORT"):
   106	        tape_opposes = tape_side is not None and tape_side != f.fresh_cross_side
   107	        if not tape_opposes:
   108	            return SideResolverDecision(f.fresh_cross_side, "fresh_cross", 0.52,
   109	                                        f"fresh_cross={f.fresh_cross_side}")
   110	
   111	    # 5. mean_reversion — lane-approved fade: RSI extreme, native trend to fade, not unanimous
   112	    if f.native_side in ("LONG", "SHORT") and f.rsi_14 is not None:
   113	        # fade a stretched move: overbought -> SHORT, oversold -> LONG
   114	        if (f.overbought or f.rsi_14 >= _RSI_OVERBOUGHT) and f.native_side == "LONG":
   115	            if not (f.htf_side == "LONG" and f.native_side == "LONG" and f.momentum_side == "LONG"):
   116	                return SideResolverDecision("SHORT", "mean_reversion", 0.5,
   117	                                            f"fade overbought rsi={f.rsi_14:.0f}")
   118	        if (f.oversold or f.rsi_14 <= _RSI_OVERSOLD) and f.native_side == "SHORT":
   119	            if not (f.htf_side == "SHORT" and f.native_side == "SHORT" and f.momentum_side == "SHORT"):
   120	                return SideResolverDecision("LONG", "mean_reversion", 0.5,
   121	                                            f"fade oversold rsi={f.rsi_14:.0f}")
   122	
   123	    # 6. native — fallback (demoted from the champion's implicit law)
   124	    if f.native_side in ("LONG", "SHORT"):
   125	        # abstain when native disagrees with a decided HTF and nothing above rescued it —
   126	        # the champion's htf_disagreement paths are the loss-heavy ones.
   127	        if f.htf_side in ("LONG", "SHORT") and f.htf_side != f.native_side:
   128	            return SideResolverDecision(None, "sit_out", 0.0,
   129	                                        f"native={f.native_side} vs htf={f.htf_side} unrescued")
   130	        return SideResolverDecision(f.native_side, "native", 0.45, "native fallback")
   131	
   132	    # 7. sit_out
   133	    return SideResolverDecision(None, "sit_out", 0.0, "no owner earned a side")

