  2995	        # Default 0.50: cached SOL 15m Jan20-Apr20 comparison beat 0.35 on WR and
  2996	        # net PnL, and this gate treats confirmed LTF as late-entry risk. Now
  2997	        # per-asset via ltf_confirm_strength_min (default == legacy SOL value).
  2998	        confirmed = strength >= self.ltf_confirm_strength_min
