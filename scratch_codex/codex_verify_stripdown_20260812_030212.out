  2968	                strength += 0.40
  2969	                reasons.append(f"{label} MACD bull cross")
  2970	            if macd.histogram_rising:
  2971	                if macd.prev_histogram < 0 and macd.histogram > 0:
  2972	                    strength += 0.35
  2973	                    reasons.append(f"{label} hist red-to-green")
  2974	                elif macd.histogram > macd.prev_histogram:
  2975	                    strength += 0.15
  2976	                    reasons.append(f"{label} hist rising")
  2977	            if macd.macd_line > macd.signal_line:
  2978	                strength += 0.10
  2979	                reasons.append(f"{label} MACD above signal")
  2980	        else:  # SHORT
  2981	            if macd.crossover == "BEARISH_CROSS":
  2982	                strength += 0.40
  2983	                reasons.append(f"{label} MACD bear cross")
  2984	            if not macd.histogram_rising:
  2985	                if macd.prev_histogram > 0 and macd.histogram < 0:
  2986	                    strength += 0.35
  2987	                    reasons.append(f"{label} hist green-to-red")
  2988	                elif macd.histogram < macd.prev_histogram:
  2989	                    strength += 0.15
  2990	                    reasons.append(f"{label} hist falling")
  2991	            if macd.macd_line < macd.signal_line:
  2992	                strength += 0.10
  2993	                reasons.append(f"{label} MACD below signal")
