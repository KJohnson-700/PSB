   435	    def _btc_follow_1h_ok(self, btc_ta: TechnicalAnalysis, allowed_side: str) -> bool:
   436	        macd_1h = btc_ta.macd_1h
   437	        min_hist = self.btc_follow_1h_hist_min
   438	        rec_mag = abs(float(self.btc_follow_1h_recovery_hist_floor))
   439	        if allowed_side == "LONG":
   440	            base_ok = (
   441	                macd_1h.histogram > min_hist
   442	                or (macd_1h.histogram > 0 and macd_1h.histogram_rising)
   443	                or macd_1h.crossover == "BULLISH_CROSS"
   444	            )
   445	            if base_ok:
   446	                return True
   447	            if self.btc_follow_1h_allow_rising_recovery:
   448	                # Negative histogram repairing upward (still below strict bullish thresholds).
   449	                if macd_1h.histogram_rising and macd_1h.histogram > -rec_mag:
   450	                    return True
   451	            if self.btc_follow_1h_allow_floor_without_rising:
   452	                # Shallow bearish 1H histogram while HTF still bullish (tape often lagging MACD slope).
   453	                if macd_1h.histogram > -rec_mag:
   454	                    return True
   455	            return False
   456	        base_ok = (
   457	            macd_1h.histogram < -min_hist
   458	            or (macd_1h.histogram < 0 and not macd_1h.histogram_rising)
   459	            or macd_1h.crossover == "BEARISH_CROSS"
   460	        )
   461	        if base_ok:
   462	            return True
   463	        if self.btc_follow_1h_allow_rising_recovery:
   464	            # Positive histogram rolling over / repairing downward for SHORT continuation.
   465	            if (not macd_1h.histogram_rising) and macd_1h.histogram < rec_mag:
   466	                return True
   467	        if self.btc_follow_1h_allow_floor_without_rising:
   468	            # Shallow bullish histogram failing stronger bear rules — still below ceiling.
   469	            if macd_1h.histogram >= 0 and macd_1h.histogram < rec_mag:
   470	                return True

