    37	  hype_alt_fetch_min_interval_sec: 55   # 2026-08-11 decouple HYPE-alt's fragile fetch from loop speed: fetch at most every ~55s regardless of cycle_interval, reuse cache between. 0 => fetch every cycle (legacy). Requires scanner_slug_cache_enabled.
