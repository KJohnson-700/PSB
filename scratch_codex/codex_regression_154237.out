         self._updown_stop_gap_bypass_pct = float(
             exit_cfg.get("updown_stop_gap_bypass_pct", 0.0) or 0.0
         )
         # Mechanism-agnostic phantom-exit guard: refuse the EARLY % stop/TP on an
