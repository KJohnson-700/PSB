                     _exit_fill_ratio = (
                         round(min(1.0, _cap_depth / float(pos.size)), 4)
                         if pos.size
                         else None
                     )
 
                 # PAPER CALIB Phase 3.6: raw (mark, no slippage/fee) vs execution-adjusted
