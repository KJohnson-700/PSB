def rows(path):
    with path.open() as f:
        for line in f:
            if line.strip():
                yield json.loads(line)

def is_exit(r): return r.get('event')=='EXIT'
def is_fav(r):
    e=r.get('extra') or {}
    return e.get('side_source')=='favorite_lane' or e.get('signal_reason')=='favorite_lane' or 'favorite_lane' in str(r.get('reason',''))
def is_rsi(r): return 'rsi_fade' in str((r.get('extra') or {}).get('side_source','')) or 'rsi_fade' in str(r.get('reason',''))

def summarize(label, rs):
    rs=list(rs); n=len(rs); pnl=sum(float(r.get('pnl') or 0) for r in rs); wins=sum(1 for r in rs if (r.get('extra') or {}).get('result')=='WIN' or float(r.get('pnl') or 0)>0)
    print(f\"{label}\\tn={n}\\twins={wins}\\twr={(wins/n if n else 0):.3f}\\tpnl={pnl:.2f}\\tavg={(pnl/n if n else 0):.2f}\")

for sess in sessions:
    exits=[r for r in rows(sess) if is_exit(r)]
    if not exits: continue
    print('\\nSESSION', sess.parent.name)
    summarize('all', exits)
    summarize('favorite', [r for r in exits if is_fav(r)])
    summarize('nonfav', [r for r in exits if not is_fav(r)])
